{
  "name": "@kun/ntable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prepare-sites-build.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "build:lib": "node scripts/build-library-css.mjs && vite build --config vite.lib.config.mjs && tsc -p tsconfig.lib.json && node scripts/prepare-library-types.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run typecheck && npm run typecheck:lib && npm run build && npm run build:lib && npm run typecheck:consumer && npm run build:consumer && npm test",
    "build:consumer": "vite build --config vite.consumer.config.mjs",
    "typecheck:consumer": "tsc -p tsconfig.consumer.json && tsc -p tsconfig.package-consumer.json && tsc -p tsconfig.package-consumer-nodenext.json",
    "typecheck:panels": "tsc -p tsconfig.lib-panels.json",
    "typecheck:lib": "tsc -p tsconfig.lib.json --noEmit"
  },
  "dependencies": {
    "@dnd-kit/react": "^0.5.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-virtual": "^3.14.13",
    "lucide-react": "1.48.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "^7.0.2",
    "vite": "6.4.2",
    "@radix-ui/react-dialog": "^1.1.23"
  },
  "description": "Embeddable React table with controlled views and hierarchical records",
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/types/ntable/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/types/ntable/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./style.css": {
      "types": "./dist/lib/style.d.ts",
      "default": "./dist/lib/ntable.css"
    }
  },
  "files": [
    "dist/lib",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ]
}
